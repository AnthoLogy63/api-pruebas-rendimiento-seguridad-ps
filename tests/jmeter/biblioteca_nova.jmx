          <stringProp name="HTTPSampler.path">/libros/estadisticas</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /libros/buscar?categoria=Novela" enabled="true">
